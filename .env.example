DATABASE_URL=

# Server-only. Never expose to the client (no VITE_ prefix). The app fails
# closed (no Paystack calls, webhook signatures rejected) if this is missing.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# Base URL of the deployed app — used to build the allowlisted Paystack
# callback redirect (/payment-success) and ticket links.
APP_URL=https://www.conference-wihcn.xyz

# Optional overrides:
# Static Paystack Payment Page used by the registration flow.
PAYSTACK_PAYMENT_PAGE_URL=https://paystack.shop/pay/wihcniii2026
# Extra https URLs Paystack may redirect to after checkout (comma-separated).
PAYSTACK_EXTRA_CALLBACK_URLS=

RESEND_API_KEY=

ADMIN_EMAIL=raynovastudio@gmail.com

# Neon Managed Better Auth gateway (URL shown in Neon > Auth).
# A working default is baked into src/lib/neon-auth-config.ts, so these are
# optional overrides only. Set them in Vercel if you ever move the gateway.
NEON_AUTH_URL=
VITE_NEON_AUTH_URL=